{
  "name": "aulaquiz",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "build:local": "npm run build",
    "build:biologia-local": "tsc -b && node scripts/verify-production-content.mjs --source-only --biologia-local && vite build --mode biologia-local && node scripts/verify-production-content.mjs --biologia-local",
    "test:e2e:biologia-local": "node scripts/run-real-bank-tests.mjs --biologia-local",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/verify-production-content.mjs --source-only && vite build && node scripts/verify-production-content.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src tests-academic --exclude publicacion/**",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-playwright.mjs",
    "verify:production": "node scripts/verify-production-content.mjs",
    "test:e2e:real": "node scripts/run-real-bank-tests.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.1"
  }
}
