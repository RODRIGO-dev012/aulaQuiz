{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Banco AulaQuiz v1",
  "description": "Un banco por archivo. Las preguntas reales requieren una clave de respuestas suministrada y verificada. Sintaxis LaTeX: \\( ... \\), \\[ ... \\]; química: \\ce{H2O}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "grade",
    "title",
    "description",
    "color",
    "shuffleQuestions",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "maxLength": 100
    },
    "subject": {
      "type": "string",
      "enum": [
        "Ciencias Sociales",
        "Química",
        "Física",
        "Matemáticas",
        "Lenguaje",
        "Biología"
      ]
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "color": {
      "enum": [
        "blue",
        "purple",
        "green",
        "mint"
      ]
    },
    "demo": {
      "type": "boolean",
      "default": false
    },
    "shuffleQuestions": {
      "type": "boolean"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/question"
      }
    }
  },
  "definitions": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "text",
        "options",
        "correctOptionId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 100
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "correctOptionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 100
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "image": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^(https://[^\\s]+|images/[a-zA-Z0-9_./-]+\\.(png|jpg|jpeg|webp|svg))$"
        },
        "imageAlt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "shuffleOptions": {
          "type": "boolean",
          "default": true
        }
      },
      "dependencies": {
        "image": [
          "imageAlt"
        ]
      }
    }
  },
  "$comment": "Además del esquema: IDs de preguntas únicos por banco; IDs de opciones únicos por pregunta; correctOptionId debe existir; image no admite segmentos ..; fórmulas no interpretan HTML ni comandos confiables."
}